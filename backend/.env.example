# Backend/SaaS core
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
SUPABASE_ANON_KEY=your_supabase_anon_key
TURNSTILE_SECRET_KEY=your_cloudflare_turnstile_secret
ADMIN_TOKEN_SECRET=change_this_secret

# Optional admin defaults
ADMIN_EMAIL=admin@transcriptai-eg.com
ADMIN_PASSWORD=change_this_password

# Optional CORS and storage
ALLOWED_ORIGINS=https://your-domain.com
PAYMENT_PROOF_BUCKET=payment-proofs

# Optional local backend mode
PORT=5000
NODE_ENV=development
