# Backend/SaaS core
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
SUPABASE_SECRET_KEY=your_supabase_secret_key
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
TURNSTILE_SECRET_KEY=your_cloudflare_turnstile_secret
ADMIN_TOKEN_SECRET=change_this_secret

# Optional admin defaults
ADMIN_EMAIL=admin@transcriptai-eg.com
ADMIN_PASSWORD=change_this_password

# Optional CORS and storage
ALLOWED_ORIGINS=https://your-domain.com
PAYMENT_PROOF_BUCKET=payment-proofs

# Optional Supabase Auth email branding (confirmation + recovery)
SUPABASE_ACCESS_TOKEN=your_supabase_management_token
SUPABASE_PROJECT_REF=your_project_ref
AUTH_SITE_URL=https://transcripta.tech
AUTH_EMAIL_FROM_NAME=Transcripta Support
AUTH_EMAIL_FROM_ADDRESS=support@your-domain.com

# Custom SMTP (required if you want sender email to be support@/hello@ instead of Supabase default)
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_USER=smtp_username
SMTP_PASS=smtp_password
SMTP_SECURE=false

# Optional admin notifications on new signup
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id
ADMIN_NOTIFY_EMAIL=admin@your-domain.com
ADMIN_NOTIFY_FROM_NAME=Transcripta Alerts
ADMIN_NOTIFY_FROM_EMAIL=alerts@your-domain.com

# Optional local backend mode
PORT=5000
NODE_ENV=development
