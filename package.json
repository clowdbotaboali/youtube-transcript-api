{
  "name": "transcripta-ai",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "npm run seo:deploy",
    "test": "node scripts/check-env-examples.js && node --check api/index.js",
    "build:frontend": "npm --prefix frontend install && npm --prefix frontend run build:compile",
    "transcript:batch": "node scripts/batch-transcript-extract.mjs",
    "seo:generate-sitemap": "node scripts/generate-sitemap.mjs",
    "seo:validate-sitemap": "npm --prefix frontend run seo:validate-sitemap",
    "seo:ping-search-engines": "node scripts/ping-search-engines.mjs",
    "seo:check-urls": "node scripts/check-urls.mjs",
    "seo:indexnow": "node scripts/indexnow.mjs",
    "seo:deploy": "npm run seo:generate-sitemap && npm run build:frontend && npm run seo:validate-sitemap && npm run seo:ping-search-engines && npm run seo:check-urls && npm run seo:indexnow",
    "auth:email:configure": "node scripts/configure-supabase-auth-email.js --apply",
    "auth:email:dry-run": "node scripts/configure-supabase-auth-email.js"
  },
  "dependencies": {
    "@distube/ytdl-core": "^4.16.12",
    "@supabase/supabase-js": "^2.97.0",
    "groq-sdk": "^0.5.0",
    "nodemailer": "^8.0.1",
    "youtube-transcript": "^1.0.4"
  },
  "devDependencies": {
    "vitest": "^4.1.2"
  }
}
